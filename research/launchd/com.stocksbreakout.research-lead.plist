<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.stocksbreakout.research-lead</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gilhadas/Documents/GitHub/stocksBreakout/venv/bin/python</string>
    <string>/Users/gilhadas/Documents/GitHub/stocksBreakout/research/runner.py</string>
    <string>--role</string><string>lead</string>
    <string>--force</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/gilhadas/Documents/GitHub/stocksBreakout</string>
  <!-- FIXED 2026-07-30: was Hour=18/Minute=47, written as if it were ET but
       StartCalendarInterval Hour/Minute are the MACHINE'S LOCAL TIME (IDT,
       UTC+3), not ET (UTC-4 in summer). That made this fire at 18:47 IDT =
       11:47 AM ET — mid-trading-day, before docker/crontab's 16:30/19:30/20:30
       ET jobs (Phase 2 re-eval, evening scan, validate_signals) had run.
       Confirmed via research_lead.log's own mtimes and repeated "0 new signal
       file(s)" ticks — the lead was frequently starved of that day's data.
       04:00 IDT ≈ 21:00 ET (with the usual 7h offset), comfortably after
       20:30 ET validate_signals even in the few weeks/year the US/Israel DST
       transitions don't align (offset drifts to 6h or 8h). Off-the-hour on
       purpose. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/gilhadas/Documents/GitHub/stocksBreakout/scanner_output/logs/research_lead.log</string>
  <key>StandardErrorPath</key><string>/Users/gilhadas/Documents/GitHub/stocksBreakout/scanner_output/logs/research_lead.err</string>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
