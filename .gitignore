*.txt
*.bak
.DS_Store
.env
/venv
.streamlit/secrets.toml
.sheet_id
token.json
credentials.json
*.csv
*.log
__pycache__/
/.vscode
/scanner_output
!cron_jobs.txt
!CLAUDE_BUILD_SUMMARY.txt
!COMPLETE_BUILDOUT.txt
!requirements.txt
!requirements-ci.txt
# Frozen dependency sets captured from a running box, used with `pip install -c`
# to hold deps constant while some other variable (arch, base image) changes.
!deploy/constraints-*.txt
/credentials/
/backtests
.claude/scheduled_tasks.lock
# Expo web build output (regenerated by: npx expo export --platform web --output-dir ../api/static)
api/static/
.claude/
_bmad/

# Server deploy secrets — templates (*.example) are tracked; real files are not.
/deploy/cloudflared/config.yml
/deploy/cloudflared/*.json

# Python packaging build artifacts (regenerated by pip install -e / setup.py)
*.egg-info/

# SQLite databases (real user data — canonical path is scanner_output/users.db,
# a Docker named volume in production; never belongs in the git working tree)
*.db

# research/ only exists as tracked content on branch research/auto-agents (its own
# research/.gitignore handles the specifics there). On any other branch its panel
# data + scratch scripts are just orphaned untracked files — ignore the whole dir
# here rather than duplicate that branch's ignore rules. Remove/narrow this if
# research/auto-agents is ever merged into main.
/research/

# .env backups: '.env' and '*.bak' both miss '.env.bak.<timestamp>',
# which is how a .bak holding live secrets got committed once before (§31).
.env.bak*
.env.*.bak
