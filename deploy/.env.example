# stocksBreakout server .env — copy to repo-root ./.env on the VM and fill in.
# This file (.env) is gitignored AND dockerignored; compose injects it via env_file.
# Fill every REQUIRED var; OPTIONAL vars can stay blank to disable that feature.

# ── Market data (REQUIRED for real signals; falls back to yfinance if blank) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=                 # OPTIONAL — catalyst web search

# ── AWS / S3 (REQUIRED for portfolio+signal sync) ────────────────────────────
# Static keys must be present in the ENV so utils._is_cloud() enables S3 mode.
# An EC2 IAM role alone will NOT trigger it — keep static keys here for parity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# ── Notifications (all OPTIONAL — blank disables that channel) ────────────────
GMAIL_APP_PASSWORD=
NOTIFY_RECIPIENTS=gil.hadas@gmail.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_BEARER_TOKEN=          # OPTIONAL — premarket X cashtag trending

# Mobile API / auth (REQUIRED for the app) ─────────────────────────────────
APP_PASSWORD=                  # legacy password login; do NOT use a documented example value
API_SECRET_KEY=                # JWT signing secret — REQUIRED, unique; the API will not boot on the documented default
ADMIN_SECRET=
DEFAULT_USER_ID=
DEFAULT_USER_EMAIL=gil.hadas@gmail.com
# DATABASE_URL=                # OPTIONAL — unset uses SQLite at scanner_output/users.db
# DB_PATH=scanner_output/users.db   # OPTIONAL — default; stays inside the volume

# ── Google OAuth (REQUIRED only if using Google login) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gilhadas-stocks.com/auth/google/callback
# Extra Google accounts allowed to sign in (comma-separated). gil.hadas@gmail.com
# and gil.hadas+1@gmail.com are always allowed; unallowlisted accounts get 403.
# GOOGLE_ALLOWLIST=
# GOOGLE_SERVICE_ACCOUNT_KEY=  # OPTIONAL — path to a mounted key file, if used
# GOOGLE_SHARE_EMAIL=

# Optional — CORS (explicit origins only; '*' is refused because credentials are on)
# CORS_ORIGINS=https://gilhadas-stocks.com,https://api.gilhadas-stocks.com,https://dashboard.gilhadas-stocks.com,http://127.0.0.1:8501,http://localhost:8501

# Second web frontend (the Streamlit dashboard) on its own subdomain. Without
# this, Google login started from the dashboard redirects to "/" on THIS
# callback's own host (gilhadas-stocks.com) instead of back to the dashboard.
DASHBOARD_PUBLIC_URL=https://dashboard.gilhadas-stocks.com

# Must match mobile/app.json's "scheme" exactly, or native Google login
# redirects to an app.json-unregistered custom scheme and the OS silently
# drops it (default "myapp" does NOT match this repo's "stocksbreakout").
MOBILE_APP_SCHEME=stocksbreakout

# ── LLM chat (OPTIONAL — powers /analyze/chat) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Trade Journal (journal.gilhadas-stocks.com) ──────────────────────────────
# Build-time args for the `journal` compose service (../TradeManagment repo).
# Values come from TradeManagment/.env.local on the Mac; the anon key is the
# public client key, not a secret. Rebuild the service after changing these:
#   docker compose up -d --build journal
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Healthchecks.io cron monitoring (OPTIONAL — blank skips pings) ───────────
# One monitor per DISTINCT daily/weekly time — see docker/crontab's header note.
# HC_UUID_DAYTRADE covers cron lines slated for removal (daytrade retirement,
# CLAUDE.md section 7); leave blank rather than provisioning a monitor for it.
HC_UUID_LONGTERM=        # Mon 9:00am ET, weekly
HC_UUID_SWING=           # weekdays 9:35am ET
HC_UUID_SWING_CLOSE=     # weekdays 4:30pm ET
HC_UUID_DAYTRADE=        # weekdays 9:35am ET — daytrade being retired, skip
HC_UUID_MONITOR=         # weekdays 9:45am-4:00pm ET, every 15min
HC_UUID_VALIDATE=        # weekdays 8:30pm ET
HC_UUID_VALIDATE_LEARN=  # Sun 9:00pm ET, weekly
