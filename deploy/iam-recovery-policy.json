{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RecoverTheDeploymentInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:RebootInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:GetConsoleOutput",
        "ec2:GetConsoleScreenshot",
        "ec2:MonitorInstances",
        "ec2:UnmonitorInstances"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:364544479452:instance/i-015657f7d29bb673e"
    },
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeAddresses",
        "ec2:DescribeSecurityGroups",
        "ec2:GetSerialConsoleAccessStatus",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SelfHealingAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:EnableAlarmActions",
        "cloudwatch:DisableAlarmActions"
      ],
      "Resource": "arn:aws:cloudwatch:eu-central-1:364544479452:alarm:stocksbreakout-*"
    },
    {
      "Sid": "ElasticIpSoTheAddressStopsChurning",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OneTimeServiceLinkedRoleForEc2AlarmActions",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::364544479452:role/aws-service-role/events.amazonaws.com/AWSServiceRoleForCloudWatchEvents",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "events.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SsmSessionManagerAsASecondWayIn",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:StartSession",
        "ssm:TerminateSession",
        "ssm:ResumeSession",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmRunCommandForPluginFreeVerification",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": [
        "arn:aws:ec2:eu-central-1:364544479452:instance/i-015657f7d29bb673e",
        "arn:aws:ssm:eu-central-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "SerialConsoleAccountToggle",
      "Effect": "Allow",
      "Action": [
        "ec2:EnableSerialConsoleAccess",
        "ec2:DisableSerialConsoleAccess"
      ],
      "Resource": "*"
    }
  ]
}
